{
  "name": "strength-ledger",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Strength Ledger: offline-first workout log for iPhone and Mac, with a Cloudflare Worker for sync. No runtime dependencies.",
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "replay": "node scripts/replay.ts",
    "build": "node scripts/build-web.ts",
    "serve": "node scripts/serve.ts",
    "e2e": "node scripts/build-web.ts && node --test --test-timeout=600000 e2e/app.e2e.ts"
  }
}
