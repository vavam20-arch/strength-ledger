// Cloudflare deployment for Strength Ledger (free plan).
// Workers Builds runs `npx wrangler deploy` on every push to main. The web app in dist/ is
// prebuilt and committed (`node scripts/build-web.ts`), so the deploy needs no build step.
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "strength-ledger",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "strength-ledger", "database_id": "d46a54a2-01a0-4826-8a20-8c833bdabe34", "migrations_dir": "worker/migrations" }
  ],
  "kv_namespaces": [
    { "binding": "BACKUPS", "id": "704e81a8e5914b37b5db9c5abbbc0fe3" }
  ],
  // Daily housekeeping at 08:17 UTC: prune change history older than 90 days.
  "triggers": { "crons": ["17 8 * * *"] },
  "observability": { "enabled": true }
}
